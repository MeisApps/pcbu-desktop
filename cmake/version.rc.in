#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @CMAKE_PROJECT_VERSION_MAJOR@,@CMAKE_PROJECT_VERSION_MINOR@,@CMAKE_PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @CMAKE_PROJECT_VERSION_MAJOR@,@CMAKE_PROJECT_VERSION_MINOR@,@CMAKE_PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE @VERSION_FILE_TYPE@
FILESUBTYPE VFT2_UNKNOWN

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Meis Apps"
            VALUE "FileDescription", "@VERSION_DESCRIPTION@"
            VALUE "FileVersion", "@CMAKE_PROJECT_VERSION@"
            VALUE "InternalName", "@TARGET@"
            VALUE "OriginalFilename", "@VERSION_FILE_NAME@"
            VALUE "ProductName", "PulseUnlock"
            VALUE "ProductVersion", "@CMAKE_PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
